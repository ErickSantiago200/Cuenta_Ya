# Configuración de Firebase para Cuenta Ya.
# 1. Copia este archivo como `.env.local` (está ignorado por git).
# 2. Rellena los valores con la configuración de tu app web en
#    Firebase Console > Configuración del proyecto > Tus apps > SDK setup and configuration.
# Estos valores identifican el proyecto en el navegador; la seguridad la dan las
# reglas de Firebase y los dominios autorizados, no el secreto de estas claves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Bucket de Firebase Storage (Documentos Anexos), p. ej. <proyecto>.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=
